{
  "name": "lensmate",
  "version": "0.0.0",
  "private": true,
  "description": "LensMate AI smart glasses software track (app, protocol, core, broker, simulator, firmware, e2e)",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "pretypecheck": "pnpm build",
    "build": "pnpm -r --if-present run build",
    "pretest": "pnpm build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest --coverage && pnpm -F @lensmate/mobile test",
    "knip": "knip",
    "check:schema": "pnpm -F @lensmate/protocol check:schema",
    "check:expo": "pnpm -F @lensmate/mobile exec expo config --type public",
    "audit:high": "pnpm audit --audit-level=high",
    "measure:import": "node tools/measurement-import/dist/cli.js",
    "measure:dry-run": "jest apps/mobile/src/measurement-dry-run.test.ts --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "protobufjs-cli": "2.7.1",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
