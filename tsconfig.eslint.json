{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react-native",
    "types": ["jest", "node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tools/*/src/**/*.ts",
    "services/*/src/**/*.ts",
    "apps/mobile/app/**/*.tsx",
    "apps/mobile/src/**/*.ts",
    "apps/mobile/src/**/*.tsx",
    "apps/mobile/app.config.ts"
  ]
}
