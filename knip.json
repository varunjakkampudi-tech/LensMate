{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["**/*.{ts,mjs,cjs}"]
    },
    "packages/core": {
      "project": ["src/**/*.ts"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.tsx"]
    },
    "services/broker": {
      "entry": ["src/admin-cli.ts", "src/migrate-cli.ts"]
    }
  },
  "ignore": ["apps/mobile/public/sw.js"]
}
