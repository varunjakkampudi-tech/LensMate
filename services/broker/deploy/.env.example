# Names and placeholders only. Copy to .env on the server (never commit it). Real values come from the owner.
BROKER_MODE=mock
# Owner-confirmed monthly cap in paise (proposed start: 50000 = INR 500; not yet approved).
BROKER_MONTHLY_CAP_PAISE=
# Owner exchange-rate setting, paise per USD. No default.
BROKER_FX_PAISE_PER_USD=
# Must equal BROKER_MONTHLY_CAP_PAISE before live mode starts.
BROKER_OWNER_CAP_CONFIRMATION_PAISE=
# Spend-continuity anchor path (inside the container volume). Required when a database is used.
BROKER_LEDGER_ANCHOR_FILE=
# Reverse-proxy hops in front of the broker (1 when the TLS proxy runs on the host).
BROKER_TRUST_PROXY_HOPS=1
# Database and provider secrets are never set here. Use the *_FILE variables with Docker secrets (see README.md).
# Devices enrol with owner-issued single-use codes; there is no client list in the environment.
